{:version 1
 :doc "fs-monopoly 根视图与 UI 下一层的真实窗口截图（#183 默认 span 顺序）"
 :steps [{:op :wait-frames :n 4}
         {:op :assert-view :focus [] :fitted true :message "root view"}
         {:op :screenshot :evidence "root.png"} {:op :dump-canvas :evidence "root-canvas.edn"}
         {:op :dump-view :evidence "root-view.edn"}
         {:op :double-click-class :id :ui}
         {:op :wait-frames :n 4}
         {:op :assert-view :focus [:ui] :fitted true :message "entered ui"}
         {:op :screenshot :evidence "ui.png"}
         {:op :dump-view :evidence "ui-view.edn"}
         {:op :dump-canvas :evidence "ui-canvas.edn"} {:op :quit :code 0}]}
