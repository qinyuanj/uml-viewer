#!/bin/sh
# Thin Unix entry, installed in the examined project.
ROOT=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P) || exit 1
PYTHON=${UML_PYTHON_EXECUTABLE:-python3}
if ! command -v "$PYTHON" >/dev/null 2>&1; then
  echo 'uml: 需要原生 Python 3.11+。' >&2
  exit 1
fi
TOOL_ROOT=${UML_VIEWER_TOOL_ROOT:-"$ROOT/.uml-viewer/uml-viewer"}
exec "$PYTHON" -I -B "$TOOL_ROOT/scripts/uml_posix.py" command "$ROOT" "$@"
