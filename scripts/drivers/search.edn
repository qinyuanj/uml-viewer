{:version 1
 :doc "Ctrl+F 搜索 driver（#140，原 Lua driver）：Ctrl+F 聚焦搜索框；中文 textinput
       与粘贴（egui Event::Text / Event::Paste，走 TextEdit 自身的输入路径）进入搜索框；
       深层目标与同名类都列出；打开的搜索框截获画布快捷键与框内指针（egui 下 imgui 捕获
       断言的等价物）；Down 显式选中第一个结果；Enter 进入目标命名空间、选中并打开卡片。
       Lua 版里两个源码窗口并存/关闭其一的断言属于 #141 源码窗口，由其 driver 承接；
       imgui.ini 隔离断言无 egui 对应物（egui 不写 ini）。"
 :steps [{:op :wait-frames :n 3}
         {:op :key :key "f" :ctrl true}
         {:op :wait-frames :n 2}
         {:op :dump-view :evidence "search-open.edn"}
         {:op :assert :evidence "search-open.edn" :contains ":active true"
          :message "Ctrl+F focuses search"}

         {:op :text :text "解析"}
         {:op :wait-frames :n 1}
         {:op :dump-view :evidence "search-typed.edn"}
         {:op :assert :evidence "search-typed.edn" :contains ":query \"解析\""
          :message "Chinese textinput reaches search"}
         {:op :assert :evidence "search-typed.edn" :contains ":alpha.deep.parser"
          :message "deep target appears"}
         {:op :assert :evidence "search-typed.edn" :contains ":beta.parser"
          :message "same-name target is disambiguated"}

         {:op :paste :text "器"}
         {:op :wait-frames :n 1}
         {:op :dump-view :evidence "search-pasted.edn"}
         {:op :assert :evidence "search-pasted.edn"
          :contains [":query \"解析器\"" ":alpha.deep.parser" ":beta.parser"]
          :message "pasted Chinese reaches search"}

         {:op :record-view :as :before}
         {:op :key :key "p"}
         {:op :key :key "r"}
         {:op :key :key "=" :ctrl true}
         {:op :drag :from [750 60] :to [650 160]}
         {:op :mouse-move :at [750 60]}
         {:op :wheel :dy 2 :ctrl true}
         {:op :assert-view :focus-unchanged :before :zoom-unchanged :before :cam-unchanged :before
          :selected-unchanged :before :message "search captures canvas shortcuts"}

         {:op :key :key "down"}
         {:op :dump-view :evidence "search-selected.edn"}
         {:op :assert :evidence "search-selected.edn" :contains ":selection :alpha.deep.parser"
          :message "Down selects the first explicit result"}

         {:op :key :key "enter"}
         {:op :assert-view :focus [:alpha :deep] :message "Enter enters target namespace"}
         {:op :assert-view :detail "alpha.deep.parser" :message "Enter opens target details"}
         {:op :assert-view :selected "alpha.deep.parser"
          :message "target selected for dependency highlighting"}
         {:op :dump-view :evidence "search-located.edn"}
         {:op :wait-frames :n 2}
         {:op :screenshot :evidence "search.png"}

         {:op :key :key "escape"}
         {:op :dump-view :evidence "search-closed.edn"}
         {:op :assert :evidence "search-closed.edn" :contains ":active false"
          :message "Escape closes search"}
         {:op :assert-view :focus [:alpha :deep]
          :message "Escape that closes search does not navigate back"}

         {:op :write :evidence "search-pass.txt"
          :text "PASS Ctrl+F, Chinese text and paste, same-name results, input capture, explicit Down selection, Enter cross-layer locate\n"}
         {:op :quit :code 0}]}
