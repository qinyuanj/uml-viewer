{:version 1
 :doc "companion worker driver（#142，原 test_love_companion_worker.lua）：在隔离 XDG 下用真实
       Herdr 起一个 companion（CLAUDE_BIN 为占位进程，UML_COMPANION_NO_ATTACH=1），viewer 在
       :display 之前显示等待空画布；状态行出现 Companion: ready 后写出 worker-ready.txt，
       再写入 :context :real 邮件；随后断言讨论上下文为 real、队列已出队。任何
       「ownership retained」状态都判失败。90 秒上限由 Python runner 给出。"
 :steps [{:op :wait-frames :n 3}
         {:op :screenshot :evidence "waiting.png"}
         {:op :assert-gui :path [:mail :waiting] :equals true
          :message "a companion launch waits for :display"}
         {:op :wait-gui :path [:status] :contains "Companion: ready" :seconds 120
          :message "the companion must reach ready"}
         {:op :assert-gui :path [:status] :not-contains "ownership retained"
          :message "the companion must not retain ownership"}
         {:op :write :evidence "worker-ready.txt" :text "ready; status Companion: ready\n"}
         {:op :write-project :project ".uml-viewer/to-viewer.edn"
          :text "{:next-id 2 :queue [{:id 1 :op :context :context :real}]}"}
         {:op :start-timer :as :mail}
         {:op :wait-timer :as :mail :ms 900}
         {:op :wait-frames :n 3}
         {:op :assert-gui :path [:mail :context] :equals :real
          :message "the :context mail must be applied while the companion is up"}
         {:op :assert :project ".uml-viewer/to-viewer.edn" :contains [":queue []"]
          :message "the applied mail must be popped from the durable queue"}
         {:op :write :evidence "worker-ui-pass.txt"
          :text "PASS waiting canvas, companion ready, context mail applied and popped\n"}
         {:op :quit :code 0}]}
