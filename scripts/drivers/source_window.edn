{:version 1
 :doc "源码窗口 driver（#141，原 test_love_source_window.lua）：按 lua/文件/成员名打开源码窗
       落到第 82 行、真实滚动且目标可见。另承接 #140 search driver 延后的断言：第二个源码
       窗口与第一个并存，关闭新开的那个后旧窗口保留。source-window.txt 为 GUI 记录（EDN）。"
 :steps [{:op :wait-frames :n 3}
         {:op :open-source :lang "lua" :file "source.lua" :name "M.target"}
         {:op :wait-frames :n 4}
         {:op :assert-gui :path [:sources 0 :line] :equals 82 :message "member must land on line 82"}
         {:op :assert-gui :path [:sources 0 :scroll-y] :gt 0
          :message "target must scroll beyond the first page"}
         {:op :assert-gui :path [:sources 0 :target-visible] :equals true
          :message "highlighted target must be inside the source viewport"}
         {:op :dump-gui :evidence "source-window.txt"}
         {:op :screenshot :evidence "source-window.png"}

         {:op :open-source :lang "lua" :file "source.lua"}
         {:op :wait-frames :n 4}
         {:op :assert-gui :path [:sources] :count 2 :message "two source windows must coexist"}
         {:op :assert-gui :path [:sources 1 :line] :present false :message "the second window shows the module"}
         {:op :wait-frames :n 15}
         {:op :screenshot :evidence "source-two-windows.png"}
         {:op :gui-click :at "close-source"}
         {:op :wait-frames :n 3}
         {:op :assert-gui :path [:sources] :count 1 :message "closing one window keeps the other"}
         {:op :assert-gui :path [:sources 0 :line] :equals 82 :message "the remaining window is the first one"}
         {:op :quit :code 0}]}
