{:version 1
 :doc "跳转源码 driver（#141，原 test_love_source_jump.lua）：真实双击下钻命名空间、双击叶子
       打开卡片；点卡片模块行打开整文件源码窗（不定位行，84 行，真实路径）；关掉后点成员
       M.target 落到第 82 行并高亮、真实滚动且目标可见；在第 82 行从缩进后拖到 function
       末尾，选中正好是 function（不含行号栏，制表符展开后仍映射回源码）；Ctrl+C 复制选区。
       module.txt / member.txt 为 GUI 记录（EDN），取代 Lua 的纯文本格式。"
 :steps [{:op :wait-frames :n 3}
         {:op :double-click-class :id :app}
         {:op :wait-frames :n 3}
         {:op :assert-view :focus [:app] :message "could not drill namespace"}
         {:op :double-click-class :id :app.some_module}
         {:op :wait-frames :n 3}
         {:op :assert-view :detail "app.some_module" :message "could not open leaf detail"}

         {:op :gui-click :at "module"}
         {:op :wait-frames :n 3}
         {:op :assert-gui :path [:sources] :count 1 :message "module click did not open source"}
         {:op :assert-gui :path [:sources 0 :line] :present false
          :message "module must not target a member line"}
         {:op :assert-gui :path [:sources 0 :rows] :equals 84
          :message "module must show the whole 83-line file plus trailing row"}
         {:op :assert-gui :path [:sources 0 :file] :contains "/source.lua"
          :message "module must resolve the actual file path"}
         {:op :dump-gui :evidence "module.txt"}
         {:op :screenshot :evidence "module.png"}

         {:op :gui-click :at "close-source"}
         {:op :wait-frames :n 2}
         {:op :assert-gui :path [:sources] :count 0 :message "closing the source window"}
         {:op :gui-click :at "member:M.target"}
         {:op :wait-frames :n 4}
         {:op :assert-gui :path [:sources 0 :line] :equals 82 :message "member must land on the actual line 82"}
         {:op :assert-gui :path [:sources 0 :highlighted] :equals [82]
          :message "target row must be highlighted"}
         {:op :assert-gui :path [:sources 0 :scroll-y] :gt 0 :message "target must require actual scrolling"}
         {:op :assert-gui :path [:sources 0 :target-visible] :equals true
          :message "target must be visible in the scrolled viewport"}
         {:op :dump-gui :evidence "member.txt"}
         {:op :screenshot :evidence "member.png"}

         {:op :gui-point :at "source-line:82" :prefix "  "}
         {:op :gui-press}
         {:op :gui-point :at "source-line:82" :prefix "  function"}
         {:op :wait-frames :n 1}
         {:op :gui-release}
         {:op :wait-frames :n 2}
         {:op :assert-gui :path [:sources 0 :selection] :equals "function"
          :message "source drag must select actual text without gutter"}
         {:op :gui-key :key "c" :ctrl true}
         {:op :wait-frames :n 2}
         {:op :assert-gui :path [:copied] :equals "function" :message "Ctrl+C copies the source selection"}
         {:op :screenshot :evidence "selection-chinese-tab.png"}

         {:op :write :evidence "source-jump-pass.txt"
          :text "PASS selected leaf -> module full file; member line 82 highlighted and scrolled; drag selects function; Ctrl+C copies\n"}
         {:op :quit :code 0}]}
