{:version 1
 :doc "类卡片滚动 driver（#141，原 test_love_detail_scroll.lua）：空检查器画出说明；默认
       640x700 卡片纵向溢出时没有横向溢出；指针在卡片上时滚轮按 48px 一格滚动并两端夹紧，
       且不把检查器父控件滚出视野；悬停的操作行从绘制行发布；卡片窄到 400 时出现横向滚动、
       宽到 900 时指标列贴可用宽度；New Proposal 加一行；右键提案打开 Rename/Delete 菜单。
       Lua 版直接改 state 打开卡片；这里用真实双击。"
 :steps [{:op :wait-frames :n 3}
         {:op :assert-gui :path [:inspector :empty-help] :equals true
          :message "empty-inspector explanation was not drawn"}
         {:op :screenshot :evidence "inspector-empty.png"}

         {:op :double-click-class :id :a}
         {:op :wait-frames :n 3}
         {:op :assert-view :detail "a" :message "double-click must open the class card"}
         {:op :assert-gui :path [:card :rect] :present true :message "detail card bounds missing"}
         {:op :assert-gui :path [:card :rect :w] :equals 640 :message "default card is 640 wide"}
         {:op :assert-gui :path [:card :rect :h] :equals 700 :message "default card is 700 high"}
         {:op :assert-gui :path [:card :horizontal :maximum] :lt 1
          :message "default 640x700 detail with vertical overflow must fit uncovered column"}
         {:op :screenshot :evidence "detail-default.png"}

         {:op :gui-point :at "detail-card"}
         {:op :wait-frames :n 2}
         {:op :assert-gui :path [:card :hovered] :equals true
          :message "pointer over the detail card was not detected"}
         {:op :wheel :dy -4}
         {:op :wait-frames :n 2}
         {:op :assert-gui :path [:card :scroll] :equals 192
          :message "four wheel notches must scroll four 48px steps"}
         {:op :wheel :dy -1000}
         {:op :wait-frames :n 2}
         {:op :assert-gui :path [:card :scroll] :gt 192 :message "overscroll must reach the content end"}
         {:op :assert-gui :path [:card :scroll] :lt 10000 :message "overscroll must clamp to the content end"}
         {:op :dump-gui :evidence "detail-overscroll.edn"}
         {:op :wheel :dy 1000}
         {:op :wait-frames :n 2}
         {:op :assert-gui :path [:card :scroll] :equals 0 :message "underscroll must clamp to zero"}
         {:op :wheel :dy -3}
         {:op :wait-frames :n 2}
         {:op :assert-gui :path [:card :scroll] :equals 144
          :message "three wheel notches must restore 144px"}
         {:op :assert-gui :path [:card :drawn-scroll] :equals 144
          :message "reported scroll must match application state"}
         {:op :assert-gui :path [:bounds "new-proposal" :y] :ge 12
          :message "detail wheel must not scroll the Inspector parent controls out of view"}

         {:op :gui-point :at "member:op8"}
         {:op :wait-frames :n 2}
         {:op :assert-gui :path [:card :hover] :equals "op8"
          :message "hovered operation must be published from the drawn row"}
         {:op :screenshot :evidence "inspector.png"}

         {:op :resize-card :size [400 700]}
         {:op :wait-frames :n 4}
         {:op :assert-gui :path [:card :horizontal :maximum] :gt 150
          :message "narrow detail must expose horizontal scroll to final metric columns"}
         {:op :screenshot :evidence "detail-narrow.png"}
         {:op :resize-card :size [900 700]}
         {:op :wait-frames :n 4}
         {:op :assert-gui :path [:card :horizontal :content-width] :gt 800
          :message "wide detail must anchor metrics to available content width"}
         {:op :screenshot :evidence "detail-wide.png"}

         {:op :assert-gui :path [:inspector :entries] :count 2 :message "real diagram plus one proposal"}
         {:op :gui-click :at "new-proposal"}
         {:op :wait-frames :n 4}
         {:op :assert-gui :path [:inspector :entries] :count 3 :message "New Proposal must add one row"}
         {:op :gui-click :at "proposal:plan" :button :secondary}
         {:op :wait-frames :n 2}
         {:op :assert-gui :path [:inspector :menu-open] :equals true
          :message "proposal Rename/Delete menu did not open"}
         {:op :dump-gui :evidence "detail-gui.edn"}

         {:op :write :evidence "inspector-pass.txt"
          :text "PASS empty-inspector copy, clamped detail scrolling, hovered op, narrow/wide card columns, New Proposal row and Rename/Delete menu\n"}
         {:op :quit :code 0}]}
