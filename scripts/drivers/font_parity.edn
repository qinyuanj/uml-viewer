{:version 1
 :doc "字形尺寸对等 driver（#140，原 Lua driver 的 chinese 场景）：
       1500x920、DPI 1、缩放 1 下，画布上每条文字命令按真实字库测量后都落在槽内
       （拟合字号 ≤18 且 ≤ 槽高，宽度 ≤ max_w）。canvas.png 之后（#141 承接）
       双击打开 640x700 类卡片：无横向溢出，前两行行高 20/18。"
 :steps [{:op :wait-frames :n 3}
         {:op :double-click-class :id :demo}
         {:op :click-class :id :demo.detail}
         {:op :assert-view :selected "demo.detail" :message "selected detail missing"}
         {:op :view :zoom 1.0}
         {:op :wait-frames :n 1}
         {:op :dump-display :evidence "parity-display.edn"}
         {:op :assert :evidence "parity-display.edn" :contains [":ui 1 " ":window {:h 920 :w 1500}"]
          :message "capture requires 1500x920 DPI1"}
         {:op :assert-text-fits :message "text exceeds its slot"}
         {:op :write :evidence "parity-pass.txt"
          :text "PASS 1500x920 DPI1 zoom1 canvas text bounds (chinese)\n"}
         {:op :wait-frames :n 2}
         {:op :screenshot :evidence "canvas.png"}

         {:op :double-click-class :id :demo.detail}
         {:op :wait-frames :n 3}
         {:op :assert-gui :path [:card :rect :w] :equals 640 :message "default card is 640 wide"}
         {:op :assert-gui :path [:card :rect :h] :equals 700 :message "default card is 700 high"}
         {:op :assert-gui :path [:card :horizontal :maximum] :lt 1
          :message "640x700 class card must not overflow horizontally"}
         {:op :assert-gui :path [:card :row-heights 0] :equals 20 :message "first card row is 20 high"}
         {:op :assert-gui :path [:card :row-heights 1] :equals 18 :message "second card row is 18 high"}
         {:op :dump-gui :evidence "parity-card.edn"}
         {:op :screenshot :evidence "card.png"}
         {:op :quit :code 0}]}
