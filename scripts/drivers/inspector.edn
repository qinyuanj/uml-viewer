{:version 1
 :doc "检查器 driver（#141，原 test_love_inspector.lua）：右键提案行打开 Rename/Delete 菜单；
       Rename 显出名称输入框与「取消」；Ctrl+A 后中文 textinput 进入输入框（egui TextEdit
       自身输入路径）；Sarasa 覆盖输入的中文；侧栏按钮用原绿底金字；确认改名后提案写回
       IR 与同级 policy，并保留另一个提案和其余 policy 键；左键选提案进入提案视图并给
       agent 发 :context；P 回到命名空间树；Regen 写入 :regen 邮件。
       imgui.ini 隔离断言无 egui 对应物（egui 不写 ini）。"
 :steps [{:op :wait-frames :n 3}
         {:op :gui-click :at "proposal:plan" :button :secondary}
         {:op :wait-frames :n 2}
         {:op :assert-gui :path [:inspector :menu-open] :equals true
          :message "proposal Rename/Delete menu did not open"}
         {:op :gui-click :at "rename-menu"}
         {:op :wait-frames :n 2}
         {:op :assert-gui :path [:bounds "proposal-name"] :present true
          :message "rename must reveal the input"}
         {:op :assert-gui :path [:bounds "cancel-rename"] :present true
          :message "rename must offer 取消"}

         {:op :gui-key :key "a" :ctrl true}
         {:op :text :text "中文方案输入"}
         {:op :wait-frames :n 3}
         {:op :assert-gui :path [:inspector :rename :name] :equals "中文方案输入"
          :message "rename field must receive Chinese textinput"}
         {:op :assert-fonts :extra "中文方案输入"
          :message "Sarasa must cover the typed proposal name in every role"}
         {:op :screenshot :evidence "inspector-rename.png"}
         {:op :assert-pixels :evidence "inspector-rename.png" :at "declutter"
          :fill [42 61 54] :ink [232 196 72] :tolerance 3
          :message "sidebar buttons must use original green fill and gold ink"}

         {:op :gui-click :at "rename-proposal"}
         {:op :wait-frames :n 3}
         {:op :assert-gui :path [:inspector :rename] :present false
          :message "confirming the rename must close the input"}
         {:op :assert :project "diagram.policy.edn"
          :contains [":name \"中文方案输入\"" ":keep" "保留方案" ":omit [:zzz]" ":lang :lua" ":src \"love\""]
          :message "policy write-back must keep the other proposal and policy content"}
         {:op :assert :project "diagram.edn" :contains [":name \"中文方案输入\"" "保留方案"]
          :message "IR write-back must carry the renamed and the other proposal"}

         {:op :gui-click :at "proposal:plan"}
         {:op :wait-frames :n 3}
         {:op :assert-gui :path [:proposal] :equals true :message "choosing a proposal shows it"}
         {:op :assert :project ".uml-viewer/to-agent.edn" :contains [":op :context" ":proposal-id :plan"]
          :message "choosing a proposal tells the agent the discussion context"}
         {:op :key :key "p"}
         {:op :wait-frames :n 2}
         {:op :assert-gui :path [:proposal] :equals false :message "P returns to the namespace tree"}
         {:op :assert-gui :path [:proposal-id] :present false :message "P clears the proposal id"}
         {:op :assert-gui :path [:focus] :count 0 :message "P returns to the root"}

         {:op :gui-click :at "regen"}
         {:op :wait-frames :n 2}
         {:op :assert-gui :path [:status] :contains "Regen queued"
          :message "Regen must report the queued request"}
         {:op :assert :project ".uml-viewer/to-agent.edn" :contains ":op :regen"
          :message "Regen must append a durable :regen mail"}

         {:op :wait-frames :n 2}
         {:op :screenshot :evidence "inspector.png"}
         {:op :dump-gui :evidence "inspector-gui.edn"}
         {:op :write :evidence "inspector-pass.txt"
          :text "PASS egui proposal context menu -> rename -> Chinese textinput; policy write-back keeps other proposals and keys; Sarasa glyphs; P returns namespace tree; Regen queued\n"}
         {:op :quit :code 0}]}
