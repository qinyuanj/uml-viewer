{:version 1
 :doc "字体 driver（#140，原 test_love_fonts.lua），三个场景（provisioned/override/fallback）
       共用：查找链选中的字体来源等于 UML_FONT_TEST_EXPECT；角色字号 body/title=18、
       badge=9、level=11、marker=12；整张界面文案表（strings::glyph_text）加
       UML_FONT_TEST_EXTRA 的每个字形都能解析（egui 按需栅格化到图集，不预建）；
       默认窗口 1500x920。"
 :steps [{:op :wait-frames :n 3}
         {:op :assert-fonts :message "font lookup, role sizes or glyph coverage"}
         {:op :dump-display :evidence "fonts-display.edn"}
         {:op :assert :evidence "fonts-display.edn" :contains ":window {:h 920 :w 1500}"
          :message "default viewer window must be 1500x920"}
         {:op :write :evidence "fonts-pass.txt"
          :text "PASS font source as expected; body=18 title=18 badge=9 level=11 marker=12; every UI glyph resolves; 1500x920\n"}
         {:op :quit :code 0}]}
