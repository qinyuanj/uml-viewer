{:version 1
 :doc "安全依赖线束：App 扇出中两条长平行段的无折返主干、各自分支与头部、主干和分支的悬停明细。"
 :steps
 [{:op :wait-frames :n 4}
  {:op :view :zoom 1 :center [360 240]}
  {:op :wait-frames :n 2}
  {:op :dump-canvas :evidence "bundle-safety.edn"}
  {:op :assert-canvas :path [:scene :bundles] :count 1}
  {:op :assert-canvas :path [:scene :bundles 0 :members] :count 2}
  {:op :assert-canvas :path [:scene :edges] :count 4}
  {:op :assert-canvas :path [:presentation :trunks] :count 1}
  {:op :assert-canvas :path [:presentation :heads] :count 4}
  {:op :assert-canvas :path [:presentation :branches] :count 6}

  {:op :canvas-point :world [314 197.7]}
  {:op :wait-frames :n 2}
  {:op :assert-canvas :path [:hit :kind] :equals :bundle}
  {:op :assert-canvas :path [:hover :members] :count 2}
  {:op :assert-canvas :path [:popup :rows] :equals ["app -> c" "app -> d"]}
  {:op :assert-canvas :path [:presentation :trunks 0 :hot] :equals true}
  {:op :screenshot :evidence "bundle-safety.png"}

  {:op :canvas-point :world [155.36 240]}
  {:op :wait-frames :n 2}
  {:op :assert-canvas :path [:hit :kind] :equals :edge}
  {:op :assert-canvas :path [:hover :to] :equals :d}
  {:op :assert-canvas :path [:popup :rows] :equals ["app -> d"]}
  {:op :screenshot :evidence "bundle-safety-branch.png"}
  {:op :dump-canvas :evidence "bundle-safety-branch.edn"}
  {:op :write :evidence "bundle-safety-pass.txt" :text "PASS safe dependency bundles: trunk, branches, heads, hover\n"}
  {:op :quit :code 0}]}
