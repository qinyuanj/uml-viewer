{:version 1
 :doc "画布导航 driver（#140，原 test_love_navigation.lua）：载入即 fit、双击下钻并 fit、
       Ctrl+滚轮以光标为锚缩放一档、空白处拖拽按屏幕位移/缩放平移、Ctrl+0 fit、
       Esc 返回、变换后的单击命中、滚轮平移；另加 Declutter 五档循环（不动视图）。
       断言是关系式的：record-view 记下视图，assert-view 与之比较。
       Lua 的 imgui 捕获断言在 egui 下的等价物（打开的搜索框截获画布键盘与指针）
       由 search.edn 断言。"
 :steps [{:op :wait-frames :n 3}
         {:op :assert-view :focus [] :fitted true :message "initial root is fitted"}
         {:op :dump-view :evidence "navigation-root.edn"}

         {:op :double-click-class :id :source}
         {:op :assert-view :focus [:source] :message "double click enters source"}
         {:op :assert-view :fitted true :message "drill fitted before the next frame"}
         {:op :dump-view :evidence "navigation-entered.edn"}

         {:op :mouse-move :at [300 260]}
         {:op :record-view :as :before :anchor [300 260]}
         {:op :wheel :dy 1 :ctrl true}
         {:op :assert-view :zoom-times [:before 1.1] :message "control+wheel zooms one 1.1 step"}
         {:op :assert-view :anchor [300 260] :anchor-fixed :before
          :message "zoom keeps the cursor world point"}
         {:op :dump-view :evidence "navigation-zoomed.edn"}

         {:op :assert-blank :at [900 860] :message "drag starts on blank canvas"}
         {:op :record-view :as :before}
         {:op :drag :from [900 860] :to [800 810]}
         {:op :assert-view :cam-shift [[100 50] :before] :message "blank drag pans"}
         {:op :assert-view :dragging false :message "release ends the drag"}
         {:op :dump-view :evidence "navigation-panned.edn"}

         {:op :key :key "0" :ctrl true}
         {:op :assert-view :fitted true :message "control+0 fits the usable canvas"}
         {:op :dump-view :evidence "navigation-fitted.edn"}

         {:op :key :key "escape"}
         {:op :assert-view :focus [] :message "escape returns to the root"}
         {:op :dump-view :evidence "navigation-back.edn"}

         {:op :click-class :id :source}
         {:op :assert-view :selected "source" :message "transformed click hits rendered source"}
         {:op :dump-view :evidence "navigation-selected.edn"}

         {:op :mouse-move :at [300 300]}
         {:op :record-view :as :before}
         {:op :wheel :dy -2}
         {:op :assert-view :cam-y-not-below :before :message "wheel pans down"}
         {:op :dump-view :evidence "navigation-wheel.edn"}

         {:op :record-view :as :before}
         {:op :click-declutter}
         {:op :assert-view :declutter "arrows" :message "declutter cycles full -> arrows"}
         {:op :click-declutter}
         {:op :assert-view :declutter "triangles" :message "declutter cycles arrows -> triangles"}
         {:op :click-declutter}
         {:op :assert-view :declutter "elements" :message "declutter cycles triangles -> elements"}
         {:op :click-declutter}
         {:op :assert-view :declutter "classes" :message "declutter cycles elements -> classes"}
         {:op :click-declutter}
         {:op :assert-view :declutter "full" :message "declutter cycles classes -> full"}
         {:op :assert-view :zoom-unchanged :before :cam-unchanged :before :focus-unchanged :before
          :selected-unchanged :before
          :message "declutter is a rebuild: it keeps zoom, camera, focus and selection"}
         {:op :dump-view :evidence "navigation-declutter.edn"}

         {:op :write :evidence "navigation-pass.txt"
          :text "PASS egui viewer: fit, drill, cursor zoom, drag pan, fit key, back, transformed hit, wheel, declutter cycle\n"}
         {:op :quit :code 0}]}
