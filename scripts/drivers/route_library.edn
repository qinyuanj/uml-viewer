{:version 1
 :doc "源码图连线修复前后对照（#150 验收证据）：输入 examples/library.edn（非层级、
       带成员）。固定视角：整图 zoom 0.55 中心 [358 797]（Full 档）、局部 zoom 1.0
       中心 [360 460]、Frames 档 zoom 0.25、Blocks 档 zoom 0.1（后两档中心同整图）。
       每张截图前先 dump-view。修复前后用同一脚本，只换二进制。"
 :steps [{:op :wait-frames :n 4}
         {:op :view :zoom 0.55 :center [358 797]}
         {:op :wait-frames :n 2}
         {:op :dump-view :evidence "library-full-view.edn"}
         {:op :screenshot :evidence "library-full.png"}
         {:op :view :zoom 1.0 :center [360 460]}
         {:op :wait-frames :n 2}
         {:op :dump-view :evidence "library-detail-view.edn"}
         {:op :screenshot :evidence "library-detail.png"}
         {:op :view :zoom 0.25 :center [358 797]}
         {:op :wait-frames :n 2}
         {:op :dump-view :evidence "library-frames-view.edn"}
         {:op :screenshot :evidence "library-frames.png"}
         {:op :view :zoom 0.1 :center [358 797]}
         {:op :wait-frames :n 2}
         {:op :dump-view :evidence "library-blocks-view.edn"}
         {:op :screenshot :evidence "library-blocks.png"}
         {:op :quit :code 0}]}
