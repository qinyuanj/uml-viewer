{:version 1
 :doc "提案视图连线修复前后对照（#150 验收证据）：输入 examples/uml-viewer.edn，左键
       选提案 :p-1791033119418 进入提案视图（与 inspector driver 同一入口），先记录
       viewer 自动 fit 后的 view，再设固定视角截图：Full 档 zoom 0.5 中心 [1620 1540]（左上局部）、
       Frames 档 zoom 0.25 中心 [3978 1659]、Blocks 档 zoom 0.1 中心 [4818 1659]
       （:center 是整窗中心，后两档让整图落在画布中部）。先悬停再点击，提案行才会响应。修复前后用同一脚本，只换二进制。"
 :steps [{:op :wait-frames :n 4}
         {:op :gui-point :at "proposal:p-1791033119418"}
         {:op :wait-frames :n 2}
         {:op :gui-click :at "proposal:p-1791033119418"}
         {:op :wait-gui :path [:proposal] :equals true :seconds 5
          :message "choosing a proposal shows it"}
         {:op :wait-frames :n 6}
         {:op :dump-view :evidence "proposal-fit-view.edn"}
         {:op :view :zoom 0.5 :center [1620 1540]}
         {:op :wait-frames :n 2}
         {:op :dump-view :evidence "proposal-full-view.edn"}
         {:op :screenshot :evidence "proposal-full.png"}
         {:op :view :zoom 0.25 :center [3978 1659]}
         {:op :wait-frames :n 2}
         {:op :dump-view :evidence "proposal-frames-view.edn"}
         {:op :screenshot :evidence "proposal-frames.png"}
         {:op :view :zoom 0.1 :center [4818 1659]}
         {:op :wait-frames :n 2}
         {:op :dump-view :evidence "proposal-blocks-view.edn"}
         {:op :screenshot :evidence "proposal-blocks.png"}
         {:op :quit :code 0}]}
