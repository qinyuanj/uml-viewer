{:version 1
 :doc "metrics 热重载 driver（#139，原 Lua driver）：等字节的快照编辑
       （:crap 1 -> :crap 9）必须触发重载，因为 stamp 带纳秒且大小不变；
       IR 文件本身不得被重写。"
 :steps [{:op :wait-frames :n 3}
         {:op :assert :evidence "scene-1.edn" :contains-any [":mu 1 " ":mu 1}"]
          :message "first scene lacks the crap-1 summary"}
         {:op :record-mtime :project "diagram.edn" :as :ir}
         {:op :edit :project ".metrics/crap.edn" :from ":crap 1" :to ":crap 9"
          :same-length true}
         {:op :wait-file :evidence "scene-2.edn"}
         {:op :assert :evidence "scene-2.edn" :differs-from "scene-1.edn"
          :message "a metric-only edit must publish a new scene"}
         {:op :assert :evidence "scene-2.edn" :contains-any [":mu 9 " ":mu 9}"]
          :message "reloaded scene did not pick up crap 9"}
         {:op :assert :evidence "scene-2.edn" :contains ":strokes"
          :message "edge renderer strokes missing"}
         {:op :assert :evidence "scene-2.edn" :contains ":tip"
          :message "edge renderer tip missing"}
         {:op :assert-mtime :project "diagram.edn" :same-as :ir
          :message "the IR file must not be rewritten by a metric reload"}
         {:op :write :evidence "metrics-pass.txt"
          :text "PASS metric-only reload with an equal-byte-length snapshot; IR untouched\n"}
         {:op :quit :code 0}]}
