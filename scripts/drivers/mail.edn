{:version 1
 :doc "邮件 driver（#142，原 Lua driver）：第 4 帧把 to-viewer 队列换成两条命令
       （:context 提案 + :display second.edn）；第 7 帧断言两条都已消费（mail-seen 2、
       不再等待 :display）、标题变成 Second diagram、讨论 context 为提案；随后对选中类
       依次执行右键菜单四个操作，to-agent.edn 必须与既有精确契约逐字相等；最后再写
       :context :real 与 :quit-for-restart。native-displayed.edn / native-menu-contract.edn
       为证据文件。"
 :steps [{:op :wait-frames :n 3}
         {:op :write-project :project ".uml-viewer/to-viewer.edn"
          :text "{:next-id 3 :queue [{:id 1 :op :context :context :proposal :proposal-id :p :name \"中文\"} {:id 2 :op :display :path \"second.edn\"}]}"}
         {:op :start-timer :as :mail}
         {:op :wait-timer :as :mail :ms 900}
         {:op :wait-frames :n 2}
         {:op :assert-gui :path [:mail :seen] :equals 2
          :message "both queued commands must be consumed"}
         {:op :assert-gui :path [:mail :waiting] :equals false
          :message ":display must end the waiting canvas"}
         {:op :assert-gui :path [:mail :title] :equals "Second diagram"
          :message "the :display command must load second.edn"}
         {:op :assert-gui :path [:mail :context] :equals :proposal
          :message "the discussion context must be the proposal"}
         {:op :dump-gui :evidence "native-displayed.edn"}

         {:op :click-class :id :target}
         {:op :wait-frames :n 1}
         {:op :click-class :id :target :button :secondary}
         {:op :wait-frames :n 2}
         {:op :assert-gui :path [:inspector :element-menu] :equals true
          :message "the right-click menu must open for the selected class"}
         {:op :gui-click :at "menu-refresh-crap"}
         {:op :wait-frames :n 3}
         {:op :click-class :id :target :button :secondary}
         {:op :wait-frames :n 3}
         {:op :gui-click :at "menu-refresh-mutate"}
         {:op :wait-frames :n 3}
         {:op :click-class :id :target :button :secondary}
         {:op :wait-frames :n 3}
         {:op :gui-click :at "menu-refresh-mutate-all"}
         {:op :wait-frames :n 3}
         {:op :click-class :id :target :button :secondary}
         {:op :wait-frames :n 3}
         {:op :gui-click :at "menu-omit"}
         {:op :wait-frames :n 3}
         {:op :dump-project :project ".uml-viewer/to-agent.edn" :evidence "native-menu-contract.edn"}
         {:op :assert :evidence "native-menu-contract.edn"
          :contains ["{:next-id 5 :queue [{:id 1 :op :refresh-crap :target {:id :target :kind :class :ns \"app.target\"}} {:id 2 :op :refresh-mutate :target {:id :target :kind :class :ns \"app.target\"}} {:id 3 :op :refresh-mutate-all :target {:id :target :kind :class :ns \"app.target\"}} {:id 4 :op :omit :target {:id :target :kind :class :ns \"app.target\"}}]}"]
          :message "the menu must write the exact to-agent.edn contract"}

         {:op :write-project :project ".uml-viewer/to-viewer.edn"
          :text "{:next-id 5 :queue [{:id 3 :op :context :context :real} {:id 4 :op :quit-for-restart}]}"}
         {:op :start-timer :as :quit}
         {:op :wait-timer :as :quit :ms 900}
         {:op :wait-frames :n 2}
         {:op :write :evidence "mail-pass.txt"
          :text "PASS mail consumed FIFO; display and context applied; menu contract exact; quit-for-restart\n"}
         {:op :quit :code 0}]}
