{:version 1
 :doc "DPI/窗口 driver（#140，原 test_love_dpi_window.lua 的 first 阶段，矩阵只跑 scale 1）：
       ui 缩放等于 UML_VIEWER_TEST_DPI_SCALE；字号以点为单位不变（egui 按 pixels-per-point
       栅格化，等价于 Lua font_raster=size*ui*fb 且无全局字体缩放）；按当前显示缩放计算的
       指针点中类；窗口改为 1100x700 后画布跟随；缩放 1 与 1.7 截图。
       Lua first 阶段中依赖检查器侧栏（280 宽、拖到 340、summary 卡、Regen 按钮）的断言属
       #141，依赖 mail :display / :quit-for-restart 与 session 的断言及 restart/legacy
       阶段属 #142，均由对应 ticket 的 EDN driver 承接。"
 :steps [{:op :wait-frames :n 3}
         {:op :dump-display :evidence "first-1-display.edn"}
         {:op :assert :evidence "first-1-display.edn" :contains ":ui 1 "
          :message "ui scale equals UML_VIEWER_TEST_DPI_SCALE"}
         {:op :assert :evidence "first-1-display.edn" :contains ":badge 9 :body 18"
          :message "body/badge font sizes"}
         {:op :assert :evidence "first-1-display.edn" :contains ":window {:h 920 :w 1500}"
          :message "default window 1500x920 view units"}

         {:op :click-class :id :a}
         {:op :assert-view :selected "a" :message "pointer hit missed the drawn class"}

         {:op :resize-window :size [1100 700]}
         {:op :wait-frames :n 6}
         {:op :dump-display :evidence "first-1-resized.edn"}
         {:op :assert :evidence "first-1-resized.edn" :contains ":window {:h 700 :w 1100}"
          :message "the canvas follows the resized window"}

         {:op :view :zoom 1.0}
         {:op :wait-frames :n 1}
         {:op :screenshot :evidence "first-1-zoom1.png"}
         {:op :view :zoom 1.7}
         {:op :wait-frames :n 1}
         {:op :screenshot :evidence "first-1-zoom17.png"}

         {:op :write :evidence "first-1-pass.edn" :text "{:phase :first :scale 1 :window [1100 700]}\n"}
         {:op :quit :code 0}]}
