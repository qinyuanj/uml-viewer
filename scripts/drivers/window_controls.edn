{:version 1
 :doc "无装饰窗口控件 driver：缺 libxkbcommon-x11 时 viewer 用无装饰 Wayland 窗口
       （UML_VIEWER_TEST_UNDECORATED=1 强制该模式）。拖动条上必须有最小化与关闭按钮；
       点关闭走与窗口管理器关闭相同的正常退出（exit 0）。关闭若无效，脚本走到
       :quit 1，driver 失败。"
 :steps [{:op :wait-frames :n 3}
         {:op :dump-display :evidence "window-controls-display.edn"}
         {:op :assert :evidence "window-controls-display.edn" :contains ":decorated false"
          :message "the test seam must force the undecorated window"}
         {:op :assert-gui :path [:bounds "window-minimize"] :present true
          :message "an undecorated window must offer a minimise control"}
         {:op :assert-gui :path [:bounds "window-close"] :present true
          :message "an undecorated window must offer a close control"}
         {:op :screenshot :evidence "window-controls.png"}
         {:op :gui-click :at "window-close"}
         {:op :wait-frames :n 40}
         {:op :quit :code 1}]}
