{:version 1
 :doc "review fixes driver（#142 承接 #141，原 Lua driver）：两个源码窗口各自保留
       选区；先在 first.lua 选中 FIRST，再打开 second.lua 选中 SECOND——第一个窗口的选区不被
       覆盖；Ctrl+C 复制的是聚焦（最新）窗口的 SECOND；随后在搜索框里另选一段文本复制，
       两个源码窗口的选区与源码复制结果都不被覆盖。历史 Lua driver 用原生剪贴板回调断言系统
       剪贴板；egui 的 :copied 记录的是本 viewer 交给平台的文本，系统剪贴板本身需人工验证。"
 :steps [{:op :wait-frames :n 3}
         {:op :open-source :lang "lua" :file "first.lua"}
         {:op :wait-frames :n 4}
         {:op :assert-gui :path [:sources] :count 1 :message "first source window"}
         {:op :gui-point :at "source-line:1" :prefix "local "}
         {:op :gui-press}
         {:op :gui-point :at "source-line:1" :prefix "local FIRST"}
         {:op :wait-frames :n 1}
         {:op :gui-release}
         {:op :wait-frames :n 2}
         {:op :assert-gui :path [:sources 0 :selection] :equals "FIRST"
          :message "first window must select FIRST"}

         {:op :open-source :lang "lua" :file "second.lua"}
         {:op :wait-frames :n 4}
         {:op :assert-gui :path [:sources] :count 2 :message "two source windows must coexist"}
         {:op :assert-gui :path [:sources 0 :selection] :equals "FIRST"
          :message "opening the second window must keep the first selection"}
         {:op :gui-point :at "source-line:1" :prefix "local "}
         {:op :gui-press}
         {:op :gui-point :at "source-line:1" :prefix "local SECOND"}
         {:op :wait-frames :n 1}
         {:op :gui-release}
         {:op :wait-frames :n 2}
         {:op :assert-gui :path [:sources 1 :selection] :equals "SECOND"
          :message "the second window must select SECOND"}
         {:op :assert-gui :path [:sources 0 :selection] :equals "FIRST"
          :message "the second drag must preserve the first selection"}
         {:op :gui-key :key "c" :ctrl true}
         {:op :wait-frames :n 2}
         {:op :assert-gui :path [:copied] :equals "SECOND"
          :message "Ctrl+C copies the focused window's selection"}

         {:op :gui-key :key "f" :ctrl true}
         {:op :wait-frames :n 2}
         {:op :text :text "OTHER WIDGET"}
         {:op :wait-frames :n 2}
         {:op :gui-key :key "a" :ctrl true}
         {:op :wait-frames :n 1}
         {:op :gui-key :key "c" :ctrl true}
         {:op :wait-frames :n 2}
         {:op :assert-gui :path [:copied] :equals "SECOND"
          :message "another widget's copy must not overwrite the source copy"}
         {:op :assert-gui :path [:sources 0 :selection] :equals "FIRST"
          :message "the first window keeps its own selection"}
         {:op :assert-gui :path [:sources 1 :selection] :equals "SECOND"
          :message "the second window keeps its own selection"}
         {:op :screenshot :evidence "review-two-windows.png"}
         {:op :write :evidence "clipboard-pass.txt"
          :text "PASS two independent source selections; focused copy SECOND; other widget copy did not overwrite\n"}
         {:op :quit :code 0}]}
