{:version 1
 :doc "session driver 第一阶段（#142，原 test_love_dpi_window.lua 的 first 阶段）：把检查器
       侧栏拖到 340，选中并双击打开类卡片，缩放与移动视图（不 fit），再发
       :quit-for-restart；viewer 必须把 session.edn 写到 .uml-viewer/，与 LOVE 的 schema
       相同。dump-session 在退出前记录本 viewer 自己会保存的快照。"
 :steps [{:op :wait-frames :n 3}
         {:op :gui-point :xy [1220 400]}
         {:op :gui-press}
         {:op :gui-point :xy [1190 400]}
         {:op :gui-point :xy [1160 400]}
         {:op :gui-release}
         {:op :wait-frames :n 2}
         {:op :assert-gui :path [:inspector :width] :equals 340
          :message "dragging the edge widens the sidebar to 340"}
         {:op :click-class :id :a}
         {:op :double-click-class :id :a}
         {:op :wait-frames :n 3}
         {:op :assert-view :detail "d0-a" :message "the class card must be open"}
         {:op :view :zoom 1.7}
         {:op :view :center [500 300]}
         {:op :wait-frames :n 2}
         {:op :resize-window :size [1100 700]}
         {:op :wait-frames :n 4}
         {:op :dump-session :evidence "saved-session.edn"}
         {:op :write :evidence "session-save-pass.edn"
          :text "{:phase :save :session \"expected\"}\n"}
         {:op :write-project :project ".uml-viewer/to-viewer.edn"
          :text "{:next-id 2 :queue [{:id 1 :op :quit-for-restart}]}"}
         ;; The viewer consumes the request and exits by itself: waiting
         ;; through the mail cadence is what lets it save the session.
         {:op :start-timer :as :quit}
         {:op :wait-timer :as :quit :ms 2500}]}
