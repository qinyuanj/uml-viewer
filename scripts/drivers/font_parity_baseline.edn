{:version 1
 :doc "字形尺寸对等 driver（#140，原 test_love_font_parity.lua 的 baseline 场景）：
       仓库自身的 IR，进入 uml → application，选中 uml.application.detail；
       画布文字落在槽内，并写出该类质量渲染的诊断行 quality-diagnosis.txt。"
 :steps [{:op :wait-frames :n 3}
         {:op :double-click-class :id :uml}
         {:op :double-click-class :id :uml.application}
         {:op :assert-view :focus [:uml :application] :message "baseline drills into uml.application"}
         {:op :click-class :id :uml.application.detail}
         {:op :assert-view :selected "uml.application.detail" :message "selected detail missing"}
         {:op :view :zoom 1.0}
         {:op :wait-frames :n 1}
         {:op :assert-text-fits :message "text exceeds its slot"}
         {:op :dump-quality :evidence "quality-diagnosis.txt" :id :uml.application.detail}
         {:op :write :evidence "parity-pass.txt"
          :text "PASS 1500x920 DPI1 zoom1 canvas text bounds (baseline)\n"}
         {:op :wait-frames :n 2}
         {:op :screenshot :evidence "canvas-baseline.png"}
         {:op :quit :code 0}]}
