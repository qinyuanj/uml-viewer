#!/bin/sh
# POSIX 安装入口；独立下载时引导同一版本的 Python 实现。
ROOT=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P) || exit 1
PYTHON=${UML_PYTHON_EXECUTABLE:-python3}
if ! command -v "$PYTHON" >/dev/null 2>&1; then
  echo 'get-uml-viewer: 需要原生 Python 3.11+。' >&2
  exit 1
fi
if [ -f "$ROOT/uml_posix.py" ]; then
  exec "$PYTHON" -I "$ROOT/uml_posix.py" install "$@"
fi
if ! command -v curl >/dev/null 2>&1; then
  echo 'get-uml-viewer: 独立引导需要 curl；也可从仓库运行 scripts/get-uml-viewer。' >&2
  exit 1
fi
TMP_DIR=$(mktemp -d) || exit 1
trap 'rm -rf "$TMP_DIR"' EXIT HUP INT TERM
URL=${UML_VIEWER_INSTALLER_URL:-https://raw.githubusercontent.com/qinyuanj/uml-viewer/${UML_VIEWER_REF:-main}/scripts/uml_posix.py}
curl -fsSL "$URL" -o "$TMP_DIR/uml_posix.py" || exit 1
"$PYTHON" -I "$TMP_DIR/uml_posix.py" install "$@"
exit $?
