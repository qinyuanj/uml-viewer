#!/bin/sh
# Thin entry; supports both checkout use and a standalone downloaded file.
if ! command -v pwsh >/dev/null 2>&1; then
  echo 'get-uml-viewer: PowerShell 7 (pwsh) is required. Install: https://aka.ms/powershell-install' >&2
  exit 1
fi
ROOT=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
if [ -f "$ROOT/get-uml-viewer.ps1" ]; then
  exec pwsh -NoLogo -NoProfile -File "$ROOT/get-uml-viewer.ps1" "$@"
fi
# Downloading the implementation is bootstrap only; installation lives in PS1.
if ! command -v curl >/dev/null 2>&1; then
  echo 'get-uml-viewer: curl is required for standalone bootstrap. Download scripts/get-uml-viewer.ps1 beside this entry from the same ref.' >&2
  exit 1
fi
TMP_DIR=$(mktemp -d) || exit 1
trap 'rm -rf "$TMP_DIR"' EXIT HUP INT TERM
URL=${UML_VIEWER_INSTALLER_URL:-https://raw.githubusercontent.com/qinyuanj/uml-viewer/${UML_VIEWER_REF:-main}/scripts/get-uml-viewer.ps1}
curl -fsSL "$URL" -o "$TMP_DIR/get-uml-viewer.ps1" || exit 1
pwsh -NoLogo -NoProfile -File "$TMP_DIR/get-uml-viewer.ps1" "$@"
exit $?
