{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Optional UML quality dispatch",
  "type": "object",
  "required": ["version"],
  "anyOf": [{"required": ["standardTools"]}, {"required": ["operations"]}],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "standardTools": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "sourceRoots": {"$ref": "#/$defs/options"},
        "exclude": {"$ref": "#/$defs/options"},
        "crapperOptions": {"$ref": "#/$defs/options"},
        "mutatorOptions": {"$ref": "#/$defs/options"},
        "dryerOptions": {"$ref": "#/$defs/options"}
      }
    },
    "operations": {
      "type": "object",
      "required": ["crap", "mutate"],
      "properties": {
        "crap": {
          "allOf": [
            {"$ref": "#/$defs/operation"},
            {"type": "object", "required": ["scope"], "properties": {"scope": {"enum": ["targets", "whole-tree"]}}},
            {"if": {"properties": {"scope": {"const": "whole-tree"}}}, "then": {"properties": {"forwardArgs": {"const": "none"}}}}
          ]
        },
        "mutate": {"$ref": "#/$defs/operation"},
        "dry": {"$ref": "#/$defs/operation"}
      }
    }
  },
  "$defs": {
    "options": {"type": "array", "items": {"type": "string", "pattern": "\\S"}},
    "operation": {
      "type": "object",
      "required": ["argv", "forwardArgs", "validResultExitCodes"],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "prefixItems": [{"type": "string", "pattern": "\\S"}], "items": {"type": "string"}},
        "forwardArgs": {"enum": ["append", "none"]},
        "validResultExitCodes": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0, "maximum": 255}}
      }
    }
  }
}
